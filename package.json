{
  "name": "pi-agenda",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Agenda · 行动派 — 本地桌面 AI 编程助手，支持影子快照、代码差异检查与文件和对话同步回滚",
  "author": "Pi Agenda",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm electron:install && electron-vite dev",
    "icons:generate": "node scripts/generate-icons.cjs",
    "electron:install": "node scripts/install-electron.cjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "pnpm electron:install && electron-vite preview",
    "test": "vitest run",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:mac": "pnpm build && electron-builder --mac",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack:dir": "pnpm build && electron-builder --dir"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git": "^3.28.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "dev.piagenda.desktop",
    "productName": "Pi Agenda · 行动派",
    "directories": {
      "output": "release",
      "buildResources": "resources/icons"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      { "from": "resources/icons", "to": "icons", "filter": ["icon.png", "icon.ico"] }
    ],
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "resources/icons/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.6.0 <13"
  }
}
